package-as: LiteVault

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - backups
  - dist
  - .agents
  - .git
  - .github
  - .vscode
  - ClaudeOPUS4.5.ps1
  - CLAUDE_md
  - GOLDTRACKER_RULES.md
  - STABILITY_TEST_CHECKLIST.md
  - tools
  - "*.zip"
  - "*.bak"
  - "*.lua.bak"
  - "*.obj"
  - "*SavedVariables*"
  - Libs/LibStub/tests
  - Modules/FishingDebug.lua
  - raid.png
