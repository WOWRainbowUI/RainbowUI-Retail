# ── External libraries ──────────────────────────────────────────────
Libs/LibDataBroker-1.1/LibDataBroker-1.1.lua
Libs/LibSpecialization/LibSpecialization/LibSpecialization.lua
Libs/LibButtonGlow/LibButtonGlowcustom.lua

# ── Foundation (loaded first — everything below depends on this) ────
Core/Media.lua
Core/Data.lua
Core/Changelog.lua

# ── Localization ────────────────────────────────────────────────────
Locales/Locales.lua
Locales/en_US.lua
Locales/zh_CN.lua
Locales/zh_TW.lua

# ── Core (BIT namespace) ────────────────────────────────────────────
# Core/SpellData.lua and Modules/SyncCD.lua were removed in 3.8.0 — see
# CHANGELOG.md. Party CD tracking is now implemented from scratch in
# Modules/PartyCooldowns.lua. BIT.SyncCD is still initialised as an
# empty table in Core/Core.lua because Core's LibSpec callback uses
# BIT.SyncCD.users as a player-data store; nil-guarded references in
# legacy code paths remain harmless against an empty table.
Core/Core.lua
# Shared unit-frame resolver used by AttachedInterrupts, OffensiveCDAlert
# and PartyCooldowns. Must load before any feature module that calls
# BIT.UnitFrames:GetPartyFrame.
Core/UnitFrames.lua

# ── User-facing UI (bars + settings) ────────────────────────────────
UI/UI.lua

# ── Feature modules ─────────────────────────────────────────────────
Modules/SmartMisdirect.lua
Modules/OffensiveCDAlert.lua
Modules/KeystoneList.lua
Modules/PartyCooldowns.lua
Modules/DefensiveOverlay.lua

# ── Profile system (must load AFTER all modules register defaults) ──
Profile/Profiles.lua
Profile/Profile.lua
Profile/WagoAPI.lua

# ── Developer tools ─────────────────────────────────────────────────
Tools/DebugReport.lua

# ── Settings panel (must load LAST — references every module) ───────
UI/Config.xml
UI/SettingsUI.lua
